# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
.venv-planetary/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Experiment outputs (regenerated by runs)
results/
*.log

# M5_Inference — keep folder READMEs/.gitkeep; ignore generated run artifacts
M5_Inference/results/maps/*
!M5_Inference/results/maps/.gitkeep
M5_Inference/results/metrics/*
!M5_Inference/results/metrics/.gitkeep
M5_Inference/results/figures/*
!M5_Inference/results/figures/.gitkeep

# Large PDS Cassini downloads (track manifest.csv only)
M5_Inference/data/templates/cassini_radar/bidr/*
!M5_Inference/data/templates/cassini_radar/bidr/.gitkeep
M5_Inference/data/templates/cassini_radar/thumbnails/
M5_Inference/data/benchmarks/dl_rmd_sample/*
!M5_Inference/data/benchmarks/dl_rmd_sample/.gitkeep

# Inference_Data — raw PDS binaries (keep metadata + derived CSV/JSON)
M5_Inference/Inference_Data/raw/**/*.ZIP
M5_Inference/Inference_Data/raw/**/*.TAB
M5_Inference/Inference_Data/raw/**/*.IMG
M5_Inference/Inference_Data/raw/**/*.LBL
!M5_Inference/Inference_Data/raw/**/product_metadata.json
!M5_Inference/Inference_Data/raw/**/README.md
M5_Inference/Inference_Data/derived/**/*.npy
!M5_Inference/Inference_Data/derived/**/product_summary.json
!M5_Inference/Inference_Data/derived/**/*.csv

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets — never commit credentials
.env
.env.*
*.pem
credentials.json

# Large generated data (keep small synthetic fixtures in data/ if needed)
data/**/*.parquet
data/**/*.h5

# Orphan Inference_Data/ staging — keep inventory, labels, catalogs; ignore bulk PDS
Inference_Data/**/*.IMG
Inference_Data/**/*.TAB
Inference_Data/**/*.ZIP
Inference_Data/**/*.tar.gz
Inference_Data/**/*.cub
Inference_Data/**/*.cub.gz
Inference_Data/**/*.pptx
Inference_Data/**/*.pdf
Inference_Data/**/*.docx
Inference_Data/**/*.cpgz
Inference_Data/**/log

# Google Drive / editor stubs
*.gdoc
Untitled document.gdoc
